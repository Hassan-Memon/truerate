{
  "name": "truerate",
  "version": "0.1.0",
  "description": "Check what a currency deal really cost you, against the market rate that day, with every source shown.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
